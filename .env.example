# db-preflight does NOT read .env files. This file only documents the variable name.
# Set it in your shell before a live scan (see README), using a least-privilege read-only role:
#   PowerShell: $env:DB_PREFLIGHT_DATABASE_URL = "postgresql://preflight_reader:<password>@host:5432/db"
#   Bash:       export DB_PREFLIGHT_DATABASE_URL='postgresql://preflight_reader:<password>@host:5432/db'
DB_PREFLIGHT_DATABASE_URL=
